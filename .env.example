# Le mode demo ne requiert aucune de ces variables.
# Le mode persistant echoue FERME si l'une des sections obligatoires manque.

# ── Base de donnees ───────────────────────────────────────────────────
DATABASE_URL=
DATABASE_POOL_SIZE=
# Region declaree explicitement : elle n'est JAMAIS deduite du nom d'hote
# de DATABASE_URL (plusieurs fournisseurs exposent un routeur global).
# Sans cette variable, scripts/verify-vercel.mjs sort NOT_VERIFIED.
DATABASE_REGION=

# ── Stockage objet et file de jobs (identite de WORKLOAD, cf. ADR-002) ─
AWS_REGION=
AWS_ROLE_ARN=
S3_PRIVATE_BUCKET=
INGESTION_QUEUE_URL=

# ── Identite UTILISATEUR — OIDC (ADR-007) ─────────────────────────────
# A ne pas confondre avec Vercel OIDC Federation ci-dessus, qui delivre
# des credentials AWS a la workload et n'authentifie aucune personne.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# Claims portant l'organisation et les roles (preparer/reviewer/signer/admin).
OIDC_ORGANIZATION_CLAIM=organization_id
OIDC_ROLES_CLAIM=roles
# Politique MFA IMPOSEE PAR L'IdP — PROBANT n'implemente aucun second facteur.
# `required` sans ACR ni AMR attendu fait echouer le demarrage : exiger la MFA
# sans savoir a quoi la reconnaitre validerait toutes les sessions.
OIDC_REQUIRED_ACR=
OIDC_REQUIRED_AMR=mfa
OIDC_MFA_ENFORCEMENT=required
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_JWKS_CACHE_SECONDS=900

# ── Session serveur ───────────────────────────────────────────────────
# 32 octets minimum. Ne JAMAIS partager entre Preview et Production.
AUTH_SESSION_SECRET=
AUTH_SESSION_IDLE_TTL_SECONDS=3600
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=43200
# Origine publique — sert au controle CSRF d'origine.
AUTH_APP_ORIGIN=

# ── Contexte signe machine a machine (workers d'ingestion) ────────────
PROBANT_CONTEXT_HMAC_SECRET=

# ── Limites d'ingestion ───────────────────────────────────────────────
DIRECT_UPLOAD_TTL_SECONDS=
MAX_UPLOAD_BYTES=
MAX_FEC_LINES=
MAX_LINE_BYTES=
MAX_FIELD_BYTES=
MAX_PARSE_DURATION_MS=
MAX_CONCURRENT_JOBS_PER_ORG=

# ── Rate limit et quota par organisation ──────────────────────────────
UPLOAD_RATE_LIMIT_PER_MINUTE=
UPLOAD_QUOTA_FILES_PER_DAY=
UPLOAD_QUOTA_BYTES_PER_DAY=

# ── En-tetes de securite ──────────────────────────────────────────────
# `report-only` (defaut) ou `enforce`. La bascule se decide APRES lecture
# des rapports de /api/security/csp-report.
CSP_MODE=report-only

# ── Verification Vercel (scripts/verify-vercel.mjs, hors runtime) ─────
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Mission 05 — recette jetable uniquement ; refus explicite sur Vercel production.
PROBANT_CLIENTS_DURABLE=
# Mission 09 — pont bancaire Trésorerie : « disposable » en recette jetable uniquement ; refus sur Vercel production.
PROBANT_CASH_DURABLE=
# Mission 10 — Immobilisations (mouvements, cadrage, recalcul) : « disposable » en recette jetable uniquement ; refus sur Vercel production.
PROBANT_FIXED_ASSETS_DURABLE=
# Feuille parallèle Capitaux propres (/capitaux-propres, tables eq_*) : « disposable » en recette jetable uniquement ; refus sur Vercel production.
PROBANT_CAPITAUX_DURABLE=
# Feuilles fiscales TVA puis IS (/fiscal, tables fx_*) : « disposable » en recette jetable uniquement ; refus sur Vercel production.
PROBANT_FISCAL_DURABLE=
# Recette intégration : PostgreSQL localhost, base nommée *_ci ou *_test (Clients, Trésorerie et Immobilisations).
PROBANT_CLIENTS_TEST_DATABASE_URL=

# Mission 12 disposable local recipe only; refused on Vercel production.
PROBANT_INVESTMENT_DURABLE=disabled

# Mission 17 : disposable seulement, jamais en production
PROBANT_EXCEPTIONAL_DURABLE=disabled
