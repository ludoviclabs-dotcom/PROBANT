{
  "//": "Lighthouse CI — mesure de LABORATOIRE. Les cibles de release (LCP <= 2,5 s, INP <= 200 ms, CLS <= 0,1) sont des seuils de TERRAIN au P75, mesures par le RUM interne (/api/rum). Lighthouse sert de garde-fou de non-regression sur un environnement controle, pas de preuve d'experience reelle : INP n'est pas mesurable en laboratoire, seul son proxy TBT l'est.",
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3101",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 180000,
      "url": [
        "http://127.0.0.1:3101/",
        "http://127.0.0.1:3101/dashboard/depot",
        "http://127.0.0.1:3101/dashboard/synthese",
        "http://127.0.0.1:3101/dashboard/risques",
        "http://127.0.0.1:3101/dashboard/cloisons",
        "http://127.0.0.1:3101/dashboard/referentiel",
        "http://127.0.0.1:3101/dashboard/dossier"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance", "accessibility", "best-practices"],
        "skipAudits": ["uses-http2", "canonical", "is-crawlable"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "unused-javascript": "off",
        "unsized-images": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
